# Application
APP_NAME=FieldMate AI Service
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/<database>
DATABASE_SCHEMA=ai

# FieldMate backend
FIELDMATE_API_BASE_URL=http://localhost:8080
FIELDMATE_API_TIMEOUT_SECONDS=10
FIELDMATE_INTERNAL_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# RAG
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=20
RAG_FINAL_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.3

# Document storage
DOCUMENT_STORAGE_DIR=./data/documents
MAX_PDF_SIZE_MB=30

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fieldmate-ai

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false