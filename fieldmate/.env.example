DB_HOST=localhost
DB_PORT=5432
DB_NAME=fieldmatedb
DB_USER=postgres
DB_PASS=your_database_password

JWT_SECRET=replace_with_a_secret_at_least_32_characters_long
JWT_EXPIRATION=86400000

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_CREATE_PATH=/v2/gateway/api/create

MOMO_REDIRECT_URL=https://your-public-backend.example.com/api/payments/momo/return
MOMO_IPN_URL=https://your-public-backend.example.com/api/payments/momo/ipn

MOMO_REQUEST_TYPE=captureWallet
MOMO_LANGUAGE=vi

VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-public-backend.example.com/api/payments/vnpay/return

VNPAY_IPN_URL=https://your-public-backend.example.com/api/payments/vnpay/ipn

CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

URL_RETURN_PAYMENT = http://localhost:3000/bookings